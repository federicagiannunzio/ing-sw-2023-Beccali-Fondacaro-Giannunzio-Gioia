<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.controller.GuiController.LobbySceneController">
   <children>
      <ImageView fitHeight="400.0" fitWidth="600.0">
         <image>
            <Image url="@Graphics/misc/sfondo parquet.jpg" />
         </image>
      </ImageView>
      <Label fx:id="matchID" layoutX="132.0" layoutY="181.0" text="Match ID:">
         <font>
            <Font name="Eras Bold ITC" size="13.0" />
         </font></Label>
      <Label fx:id="playersListID" layoutX="132.0" layoutY="236.0" text="Players' username:">
         <font>
            <Font name="Eras Bold ITC" size="14.0" />
         </font></Label>
      <Label fx:id="playersNumberID" layoutX="130.0" layoutY="210.0" prefHeight="18.0" prefWidth="135.0" text="Number of players:">
         <font>
            <Font name="Eras Bold ITC" size="14.0" />
         </font></Label>
      <Label layoutX="279.0" layoutY="210.0" text="2/3" />
      <Label layoutX="279.0" layoutY="236.0" text="Pietro, Giorgio" />
      <Label layoutX="204.0" layoutY="181.0" text="12345" />
      <ImageView fitHeight="76.0" fitWidth="225.0" layoutX="191.0" layoutY="55.0">
         <image>
            <Image url="@Graphics/Publisher%20material/Title%202000x618px.png" />
         </image>
         <effect>
            <DropShadow />
         </effect>
      </ImageView>
      <Button layoutX="276.0" layoutY="300.0" mnemonicParsing="false" onAction="#goToGame" stylesheets="@Login.css" text="Play">
         <effect>
            <DropShadow />
         </effect>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
   </children>
</AnchorPane>
