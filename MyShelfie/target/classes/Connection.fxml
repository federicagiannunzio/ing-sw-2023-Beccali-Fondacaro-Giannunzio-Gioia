<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Blend?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.controller.GuiController.ConnectionController">
   <children>
      <ImageView fitHeight="400.0" fitWidth="600.0">
         <image>
            <Image url="@assets/misc/sfondo%20parquet.jpg" />
         </image>
         <cursor>
            <Cursor fx:constant="DEFAULT" />
         </cursor>
      </ImageView>
      <ImageView fitHeight="76.0" fitWidth="225.0" layoutX="191.0" layoutY="55.0">
         <image>
            <Image url="@assets/Publisher%20material/Title%202000x618px.png" />
         </image>
         <effect>
            <DropShadow />
         </effect>
      </ImageView>
      <TextField fx:id="addrTF" alignment="TOP_LEFT" layoutX="46.0" layoutY="214.0" opacity="0.54" promptText="Server address" styleClass="button1" stylesheets="@Login.css" />
      <TextField fx:id="portTF" alignment="TOP_LEFT" layoutX="336.0" layoutY="214.0" opacity="0.5" promptText="Port address" styleClass="button1" stylesheets="@Login.css">
         <effect>
            <Blend />
         </effect></TextField>
      <Button layoutX="253.0" layoutY="292.0" mnemonicParsing="false" onAction="#connectToServer" stylesheets="@Connection.css" text="Connect">
         <effect>
            <DropShadow />
         </effect>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></Button>
      <Label layoutX="37.0" layoutY="180.0" text="Enter the server address:">
         <font>
            <Font name="Eras Bold ITC" size="18.0" />
         </font>
      </Label>
      <Label layoutX="336.0" layoutY="180.0" text="Enter the port address:">
         <font>
            <Font name="Eras Bold ITC" size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
