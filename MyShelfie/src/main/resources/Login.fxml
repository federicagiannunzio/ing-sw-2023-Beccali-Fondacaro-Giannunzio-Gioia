<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.controller.GuiController.LoginController">
   <children>
      <ImageView fitHeight="400.0" fitWidth="600.0" focusTraversable="true">
         <image>
            <Image url="@assets/misc/sfondo%20parquet.jpg" />
         </image>
      </ImageView>
      <TextField fx:id="usernameTF" layoutX="46.0" layoutY="214.0" opacity="0.54" promptText="Username" styleClass="button1" stylesheets="@Login.css" />
      <ImageView fitHeight="76.0" fitWidth="225.0" layoutX="191.0" layoutY="55.0">
         <image>
            <Image url="@assets/Publisher%20material/Title%202000x618px.png" />
         </image>
         <effect>
            <DropShadow />
         </effect>
      </ImageView>
      <Label fx:id="label" layoutX="55.0" layoutY="180.0" text="Enter your username:" textAlignment="CENTER">
         <font>
            <Font name="Eras Bold ITC" size="18.0" />
         </font></Label>
      <Button fx:id="loginBT" layoutX="265.0" layoutY="290.0" mnemonicParsing="false" onAction="#submit" stylesheets="@Login.css" text="Login" textAlignment="CENTER">
         <effect>
            <DropShadow />
         </effect>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></Button>
      <TextField fx:id="numberTF" layoutX="336.0" layoutY="214.0" opacity="0.54" promptText="Number of player" styleClass="button1" stylesheets="@Login.css" />
      <Label layoutX="328.0" layoutY="180.0" text="Enter the number of player:">
         <font>
            <Font name="Eras Bold ITC" size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
